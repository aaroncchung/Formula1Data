# Frontend: see frontend/.env.example. Its one variable is set in the
# committed frontend/.env.production and frontend/.env.development.

# The data plane: `python -m f1data` (docs/data-plane.md). Copied to .env at
# the repository root on the machine that fetches. Comments go on lines of
# their own, or after a space; save the file as UTF-8.
# Where the archive and published data live: r2, or a directory that exists.
F1DATA_STORE=r2
# Where a fetch waits until the store has it. Leave unset for
# %LOCALAPPDATA%\f1data\spool or ~/.cache/f1data/spool; never a store's directory.
# F1DATA_SPOOL=
# The bucket, which has to exist, and the Cloudflare account it is in.
R2_BUCKET=formula-1-data-artifacts
R2_ACCOUNT_ID=your-cloudflare-account-id
# The key pair of an R2 API token with Object Read & Write on the bucket.
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Or, in place of the key pair, a Cloudflare API token with R2 access; and
# CLOUDFLARE_ACCOUNT_ID in place of R2_ACCOUNT_ID.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Optional local pipeline / backend development
DATA_DIR=./backend/data
FASTF1_CACHE_DIR=./backend/data/cache/fastf1
OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_API_KEY=
ENABLE_LIVE_MODE=false
CORS_ORIGINS=http://localhost:3000

# Cloudflare Worker / ingestion runner
STATIC_DATA_BASE_URL=http://localhost:3000/data
CORS_ALLOW_ORIGIN=http://localhost:3000
INGESTION_WEBHOOK_URL=
INGESTION_WEBHOOK_TOKEN=
INGESTION_API_TOKEN=
# Set true only when callers can send INGESTION_API_TOKEN. For the browser flow,
# keep false and protect the Worker route with Cloudflare Access.
REQUIRE_INGESTION_REQUEST_AUTH=false
ALLOW_UNAUTHENTICATED_INGESTION_CALLBACKS=false
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_DISPATCH_EVENT=ingest_session
