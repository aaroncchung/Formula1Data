# Where the pages read published data from: the read-only Worker in front of
# R2, up to and including `/data`. The versioned layout (`v<format>/index.json`,
# `v<format>/pointers/...`, `v<format>/generations/...`) hangs off it. Set in
# .env.production and .env.development, which are committed; a value in
# .env.local or in the environment overrides both. Inlined when the site is
# built, so changing it takes a new build.
NEXT_PUBLIC_PUBLISHED_DATA_BASE_URL=https://formula-1-data-read.aaronchenxi2.workers.dev/data
