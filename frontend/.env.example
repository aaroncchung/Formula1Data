# Path the exported site reads pre-built session artifacts from.
NEXT_PUBLIC_STATIC_DATA_BASE_PATH=/data

# Cloudflare Worker origin serving the dynamic routes (session status,
# on-demand ingestion, live). Leave empty to run in static-only mode.
NEXT_PUBLIC_DYNAMIC_API_BASE_URL=

# Where pages that load at runtime read published data from: the read-only
# Worker in front of R2, up to and including `/data`. The versioned layout
# (`v1/index.json`, `v1/pointers/...`, `v1/generations/...`) hangs off it.
# Set in .env.production and .env.development; a value here or in the
# environment overrides both. Inlined when the site is built, so changing it
# takes a new build.
NEXT_PUBLIC_PUBLISHED_DATA_BASE_URL=https://formula-1-data-read.aaronchenxi2.workers.dev/data
